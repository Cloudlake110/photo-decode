{
  "skill": "photo-decode",
  "version": "1.0.0",
  "cases": [
    {
      "id": "portrait-single",
      "input_type": "portrait",
      "must": [
        "remove setting from right visual",
        "retain defining head/hair/face/garment structure",
        "palette derived from right visual",
        "every swatch has hex",
        "key elements derived from right visual"
      ]
    },
    {
      "id": "group-hierarchy",
      "input_type": "group portrait",
      "must": [
        "choose hero/support/tertiary hierarchy",
        "do not treat all people equally",
        "remove incidental background",
        "preserve group relationship"
      ]
    },
    {
      "id": "news-complex",
      "input_type": "news/documentary",
      "must": [
        "extract visible action axis",
        "remove walls/street clutter unless essential",
        "do not identify people from image alone",
        "do not invent event facts"
      ]
    },
    {
      "id": "landscape-saturated",
      "input_type": "landscape",
      "must": [
        "retain topology as flat planes",
        "compress houses/foliage",
        "palette comes from flat reinterpretation",
        "avoid generic mountain/wave template"
      ]
    },
    {
      "id": "artwork-painting",
      "input_type": "painting/artwork",
      "must": [
        "retain compositional thrust and key motifs",
        "remove painterly complexity",
        "create new flat visual language",
        "do not add unrelated symbolism"
      ]
    },
    {
      "id": "architecture-interior",
      "input_type": "architecture/interior",
      "must": [
        "retain defining modules and axes",
        "remove incidental people/clutter",
        "flatten perspective detail into structure"
      ]
    },
    {
      "id": "product-display",
      "input_type": "product/retail display",
      "must": [
        "retain hero/support product hierarchy",
        "retain display rhythm",
        "remove environment clutter",
        "key elements contain only components retained in right visual"
      ]
    },
    {
      "id": "global-layout",
      "input_type": "all",
      "must": [
        "exactly five titled blocks",
        "block titles are numbered and visible",
        "five to eight swatches",
        "hex under every swatch",
        "no sixth block"
      ]
    }
  ]
}
